{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT\"/scripts/run-ts \"$CLAUDE_PLUGIN_ROOT\"/hooks/session_start.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REX_SESSION\" ] || exit 0; sh \"$CLAUDE_PLUGIN_ROOT\"/scripts/run-ts \"$CLAUDE_PLUGIN_ROOT\"/hooks/mirror_hook.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT\"/scripts/run-ts \"$CLAUDE_PLUGIN_ROOT\"/hooks/subagent_start.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT\"/scripts/run-ts \"$CLAUDE_PLUGIN_ROOT\"/hooks/session_end.ts",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
