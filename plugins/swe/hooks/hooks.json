{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/block-agent-attribution.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/symlink-worktree-shared-dirs.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/symlink-worktree-shared-dirs.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/symlink-worktree-shared-dirs.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "if": "Edit(*.py)", "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/format-python.sh" },
          { "type": "command", "if": "Write(*.py)", "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/format-python.sh" },
          { "type": "command", "if": "MultiEdit(*.py)", "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/format-python.sh" }
        ]
      }
    ]
  }
}
