{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/link-docs-agents.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/link-docs-agents.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "if": "Edit(*.py)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/format-python.sh" },
          { "type": "command", "if": "Write(*.py)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/format-python.sh" },
          { "type": "command", "if": "MultiEdit(*.py)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/format-python.sh" }
        ]
      }
    ]
  }
}
